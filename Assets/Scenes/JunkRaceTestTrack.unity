    \u0432\u0441\u0435\u0445, \u043D\u043E \u043B\u043E\u0432\u0438\u0442 \u0432\u0435\u0442\u0435\u0440,
    \u043A\u0430\u043A \u043F\u0430\u0440\u0443\u0441. \u041D\u0435 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u044C
    \u043A\u0430\u0431\u043B\u0443\u043A\u043E\u043C."
