    \u0441\u0432\u0438\u0441\u0442\u0438\u0442 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C
    \u2014 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442."
  protection: 0.12
